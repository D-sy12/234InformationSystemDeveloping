# ---- 数据库配置 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的MySQL密码
DB_NAME=library_system

# ---- JWT 登录态 ----
JWT_SECRET=请替换成一段随机字符串
JWT_EXPIRE_HOURS=24

# ---- 管理员初始账号（首次启动自动创建，可修改）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ---- QQ 邮箱 SMTP（发验证码 / 催还邮件）----
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ号@qq.com
SMTP_PASSWORD=你的QQ邮箱SMTP授权码

# ---- 验证码 ----
MAIL_CODE_EXPIRE_MINUTES=10
